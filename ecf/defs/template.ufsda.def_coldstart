suite {{ exp_case_name }}
    family cold_cyc
{%- if SCHED == "slurm" %}
        edit ECF_JOB_CMD "sbatch %ECF_JOB%"
{%- elif SCHED == "pbs" %}
        edit ECF_JOB_CMD "qsub %ECF_JOB%"
{%- endif %}
        edit ECF_FILES "{{ exp_case_path }}/ecf/ecf_scripts"
        edit ECF_DATE {{ yyyymmdd_first }}
        edit CYC {{ hh_first }}
        task jufsda_prep_data
        task jufsda_forecast
            trigger jufsda_prep_data == complete
        task jufsda_plot_stats
            trigger jufsda_forecast == complete
    endfamily

{%- if yyyymmdd_second is not none %}
    family cycle
        trigger cold_cyc == complete
        repeat date YMD {{ yyyymmdd_second }} {{ yyyymmdd_last }} {{ date_cycle_freq_day }}
{%- if SCHED == "slurm" %}
        edit ECF_JOB_CMD "sbatch %ECF_JOB%"
{%- elif SCHED == "pbs" %}
        edit ECF_JOB_CMD "qsub %ECF_JOB%"
{%- endif %}
        edit ECF_FILES "{{ exp_case_path }}/ecf/ecf_scripts"
        edit ECF_DATE %YMD%
        edit CYC {{ hh_first }}
        task jufsda_prep_data
        task jufsda_analysis
            trigger jufsda_prep_data == complete
        task jufsda_forecast
            trigger jufsda_analysis == complete
        task jufsda_plot_stats
            trigger jufsda_forecast == complete
    endfamily
{%- endif %}
endsuite
