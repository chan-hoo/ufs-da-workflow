#############################################
####  UFS Run-Time Configuration File  ######
#############################################

# ESMF #
logKindFlag:            ESMF_LOGKIND_MULTI
globalResourceControl:  true

# EARTH #
{%- if APP == "S2SWA" %}
EARTH_component_list: MED ATM OCN ICE WAV
{%- elif APP == "NG-GODAS" %}
EARTH_component_list: MED ATM OCN ICE
{%- endif %}
EARTH_attributes::
  Verbosity = 0
::

# MED #
MED_model:                      cmeps
MED_petlist_bounds:             {{ med_petlist_bounds_n1 }} {{ med_petlist_bounds_n2 }}
MED_omp_num_threads:            1
::

# ATM #
ATM_model:                      {{ atm_model }}
ATM_petlist_bounds:             {{ atm_petlist_bounds_n1 }} {{ atm_petlist_bounds_n2 }}
ATM_omp_num_threads:            1
ATM_attributes::
  Verbosity = 0
  DumpFields = false
{%- if APP == "S2SWA" %}
  ProfileMemory = false
  OverwriteSlice = true
{%- elif APP == "NG-GODAS" %}
  mesh_atm  = {{ atm_mesh_atm }}
  diro = "."
  logfile = atm.log
  stop_n = {{ atm_stop_n }}
  stop_option = nhours
  stop_ymd = -999
  write_restart_at_endofrun = .true.
{%- endif %}
::

# OCN #
OCN_model:                      {{ ocn_model }}
OCN_petlist_bounds:             {{ ocn_petlist_bounds_n1 }} {{ ocn_petlist_bounds_n2 }}
OCN_omp_num_threads:            1
OCN_attributes::
  Verbosity = 0
  DumpFields = false
  ProfileMemory = false
  OverwriteSlice = true
  mesh_ocn = {{ ocn_mesh_ocn }}
  use_coldstart = false
  use_mommesh = true
::

# ICE #
ICE_model:                      {{ ice_model }}
ICE_petlist_bounds:             {{ ice_petlist_bounds_n1 }} {{ ice_petlist_bounds_n2 }}
ICE_omp_num_threads:            1
ICE_attributes::
  Verbosity = 0
  DumpFields = false
  ProfileMemory = false
  OverwriteSlice = true
  mesh_ice = {{ ice_mesh_ice }}
  eps_imesh = 2.5e-1
  stop_n = {{ ice_stop_n }}
  stop_option = nhours
  stop_ymd = -999
::

{%- if APP == "S2SWA" %}
# WAV #
WAV_model:                      {{ wav_model }}
WAV_petlist_bounds:             {{ wav_petlist_bounds_n1 }} {{ wav_petlist_bounds_n2 }}
WAV_omp_num_threads:            1
WAV_attributes::
  Verbosity = 0
  OverwriteSlice = false
  mesh_wav = {{ wav_mesh_wav }}
  user_histname = false
  use_historync = false
  use_restartnc = true
  restart_from_binary = false
  pio_typename = pnetcdf
  pio_numiotasks = -99
  pio_stride = 4
  pio_rearranger = box
  pio_root = -99
::
{%- endif %}

# CMEPS run sequence
runSeq::
@{{ DT_RUNSEQ }}
{%- if APP == "S2SWA" %}
   MED med_phases_prep_wav_avg
   MED med_phases_prep_ocn_avg
   MED -> WAV :remapMethod=redist
   MED -> OCN :remapMethod=redist
   WAV
   OCN
   @{{ DT_ATMOS }}
     MED med_phases_prep_atm
     MED med_phases_prep_ice
     MED -> ATM :remapMethod=redist
     MED -> ICE :remapMethod=redist
     ATM
     ICE
     ATM -> MED :remapMethod=redist
     MED med_phases_post_atm
     ICE -> MED :remapMethod=redist
     MED med_phases_post_ice
     MED med_phases_ocnalb_run
     MED med_phases_prep_ocn_accum
     MED med_phases_prep_wav_accum
   @
   OCN -> MED :remapMethod=redist
   WAV -> MED :remapMethod=redist
   MED med_phases_post_ocn
   MED med_phases_post_wav
   MED med_phases_restart_write
{%- elif APP == "NG-GODAS" %}
   MED med_phases_prep_ocn_avg
   MED -> OCN :remapMethod=redist
   OCN
   @{{ DT_ATMOS }}
     MED med_phases_prep_ice
     MED -> ICE :remapMethod=redist
     ATM
     ICE
     ATM -> MED :remapMethod=redist
     MED med_phases_post_atm
     ICE -> MED :remapMethod=redist
     MED med_phases_post_ice
     MED med_phases_ocnalb_run
     MED med_phases_aofluxes_run
     MED med_phases_prep_ocn_accum
   @
   OCN -> MED :remapMethod=redist
   MED med_phases_post_ocn
   MED med_phases_restart_write
{%- endif %}
@
::

# CMEPS variables
DRIVER_attributes::
::
MED_attributes::
      ATM_model = {{ atm_model }}
      ICE_model = {{ ice_model }}
      OCN_model = {{ ocn_model }}
{%- if APP == "S2SWA" %}
      WAV_model = {{ wav_model }}
{%- endif %}
      coupling_mode = ufs.frac
      pio_typename = pnetcdf
      pio_numiotasks = -99
      pio_stride = 4
      pio_rearranger = box
      pio_root = -99
      ocean_albedo_limit = 0.06
      mapuv_with_cart3d = true
::

ALLCOMP_attributes::
      ScalarFieldCount = 3
      ScalarFieldIdxGridNX = 1
      ScalarFieldIdxGridNY = 2
      ScalarFieldIdxGridNTile = 3
      ScalarFieldName = cpl_scalars
      start_type = {{ allcomp_start_type }}
      restart_dir = ./RESTART/
      case_name = ufs.cpld
      restart_n = {{ ALLCOMP_RESTART_N }}
      restart_option = nhours
      restart_ymd = -999
      write_restart_at_endofrun = .false.
      dbug_flag = 0
      stop_n = {{ allcomp_stop_n }}
      stop_option = nhours
      stop_ymd = -999
      read_restart = {{ allcomp_read_restart }}
      orb_eccen = 1.e36
      orb_iyear = 2000
      orb_iyear_align = 2000
      orb_mode = fixed_year
      orb_mvelp = 1.e36
      orb_obliq = 1.e36
::
