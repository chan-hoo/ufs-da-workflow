#!/bin/bash -l
{%- if WORKFLOW_MANAGER != "rocoto" %}
{%- if SCHED == "slurm" %}
#SBATCH --account={{ ACCOUNT }}
#SBATCH --job-name={{ task_name }}
#SBATCH --output={{ output_name }}
#SBATCH --partition={{ partition_queue }}
#SBATCH --qos={{ qos }}
#SBATCH --time={{ wall_time }}
#SBATCH --nodes={{ num_nodes }}
#SBATCH --ntasks-per-node={{ ntasks_per_node }}
#SBATCH --mem={{ memory_per_node }}
{%- elif SCHED == "pbs" %}
#PBS -S /bin/bash
#PBS -A {{ ACCOUNT }}
#PBS -N {{ task_name }}
#PBS -o {{ output_name }}
#PBS -j oe
#PBS -q {{ partition_queue }}
#PBS -l walltime={{ wall_time }}
#PBS -l nodes={{ num_nodes }}:ppn={{ ntasks_per_node }}
#PBS -l mem={{ memory_per_node }}
{%- endif %}
{%- endif %}

{%- if WORKFLOW_MANAGER == "ecflow" %}
%include <head.h>
%include <envir-p1.h>
export cyc=%CYC%
{%- endif %}

## Export task-specific environment variables
source "{{ exp_case_path }}/task_env/{{ task_name }}.env"

## Load module files for task "{{ task_name }}"
{%- if MACHINE == "gaeac6" %}
module reset
{%- else %}
module purge
{%- endif %}
source "{{ HOMEufsda }}/versions/run.ver_{{ MACHINE }}"
module use {{ HOMEufsda }}/modulefiles/tasks/{{ MACHINE }}
module load task.{{ task_name }}
module list

#################################
## Replacement of J-job script
#################################
source {{ HOMEufsda }}/parm/jjob_env_setup.sh

### Run task ex-script
{{ HOMEufsda }}/scripts/exufsda_{{ task_name }}.sh

if [ -e "$pgmout" ]; then
  cat $pgmout
fi
if [ "${KEEPDATA}" = "NO" ]; then
  rm -rf ${DATA}
fi
date

{%- if WORKFLOW_MANAGER == "ecflow" %}
%include <tail.h>
{%- endif %}
