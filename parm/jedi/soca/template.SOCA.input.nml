 &MOM_input_nml
         output_directory = './MOM6_OUTPUT',
         input_filename = '{{ mom_input_filename }}'
         restart_input_dir = 'INPUT/',
         restart_output_dir = './RESTART/',
         parameter_filename = 'INPUT/MOM_input'
/

 &diag_manager_nml
 /

 &ocean_solo_nml
            months = 0
            days   = 1
            date_init = {{ yyyy }},{{ mm }},{{ dd }},{{ hh }},0,0,
            hours = 0
            minutes = 0
            seconds = 0
            calendar = 'NOLEAP' /

 &fms_io_nml
      max_files_w=100
      checksum_required=.false.
/

 &fms_nml
       clock_grain='MODULE'
       domains_stack_size = 5000000
       clock_flags='SYNC'
/
